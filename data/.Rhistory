"False negative" = "lightsalmon"
)) +
theme(axis.text.x = element_text(size = 7, angle = 45, color = "black", hjust = 1),
axis.text.y = element_text(size = 7,  color = "black", vjust = 0.5),
legend.title = element_blank())
